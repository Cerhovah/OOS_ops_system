{
  "name": "oos-ops",
  "main": "expo-router/entry",
  "version": "0.5.0",
  "dependencies": {
    "@react-native-community/netinfo": "12.0.1",
    "@supabase/supabase-js": "^2.112.4",
    "expo": "~57.0.20",
    "expo-constants": "~57.0.12",
    "expo-crypto": "~57.0.2",
    "expo-dev-client": "~57.0.18",
    "expo-file-system": "~57.0.4",
    "expo-linking": "~57.0.9",
    "expo-notifications": "~57.0.17",
    "expo-router": "~57.0.19",
    "expo-secure-store": "~57.0.3",
    "expo-sharing": "~57.0.18",
    "expo-splash-screen": "~57.0.8",
    "expo-sqlite": "~57.0.2",
    "expo-system-ui": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.9.1",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.2.2",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "expo-doctor": "^1.20.2",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint --max-warnings=0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:supabase-contracts": "vitest run --root .. --config mobile/vitest.config.mts supabase/functions/_shared/analysis-request.test.ts supabase/tests/security-hardening.test.ts",
    "deps:check": "expo install --check",
    "doctor": "expo-doctor .",
    "bundle:android": "expo export --platform android --output-dir dist",
    "verify": "npm run typecheck && npm run lint && npm run test:coverage && npm run test:supabase-contracts && npm run deps:check && npm run doctor && npm run bundle:android"
  },
  "engines": {
    "node": "24.19.x",
    "npm": "11.17.x"
  },
  "packageManager": "npm@11.17.0",
  "private": true
}
